{
  "extends": "./.claude-plugin/types/tsconfig.json",
  "compilerOptions": {
    // No claude-code-tools or claude-code-mcp: they type the tools of the
    // session that wrote them, and the hooks call no tool by its schema.
    "types": ["claude-code"],
    // Also here: without .claude-plugin/types/ the base is missing, and tsc
    // would write .js files beside the sources.
    "noEmit": true
  }
}
